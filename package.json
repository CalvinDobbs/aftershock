{
  "name": "aftershock",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test",
    "demo": "pnpm --parallel --filter @aftershock/orchestrator --filter @aftershock/web dev",
    "dev:web": "pnpm --filter @aftershock/web dev",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
