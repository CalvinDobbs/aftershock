{
  "name": "@aftershock/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=../../.env --import tsx src/start.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aftershock/browser": "workspace:*",
    "@aftershock/schema": "workspace:*",
    "@aftershock/scout": "workspace:*",
    "zod": "~4.4.3",
    "@aftershock/critic": "workspace:*",
    "@aftershock/sleuth": "workspace:*",
    "@aftershock/understudy": "workspace:*",
    "@aftershock/curtain-call": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  }
}
