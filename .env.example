# --- Browserbase -------------------------------------------------------------
# The Browserbase project resolves from the API key; no project id is needed.
BROWSERBASE_API_KEY=

# --- Models ------------------------------------------------------------------
OPENAI_API_KEY=
STAGEHAND_MODEL=openai/gpt-5.4-mini

# --- GitHub App --------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Storage -----------------------------------------------------------------
DATABASE_URL=
# Evidence root: JSONL event traces and content-addressed screenshots.
AFTERSHOCK_DATA_DIR=.aftershock

# --- Director tuning ---------------------------------------------------------
MAX_CONCURRENT=3
AGENT_TIMEOUT_MS=120000
CONFIDENCE_THRESHOLD=0.70
MAX_ISSUES_PER_RUN=3

# DEMO_MODE short-circuits deployment waits, uses a pre-warmed context, and
# lets the dashboard replay a cached golden run from the database.
DEMO_MODE=true

# --- Services ----------------------------------------------------------------
# Port the browser observability API (services/orchestrator) listens on.
PORT=3001

# --- Web ---------------------------------------------------------------------
# When unset, the dashboard serves the golden run from its own fixtures so the
# frontend runs with no backend at all.
NEXT_PUBLIC_API_URL=
# Browser observability API the live browser feeds read from.
NEXT_PUBLIC_ORCHESTRATOR_URL=http://127.0.0.1:3001
